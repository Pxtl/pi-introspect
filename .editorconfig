root = true

[*]
# Basic global settings
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{md,xml,html,json,yml,yaml,ini}]
# documents and serialization
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

[*.ts]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true
